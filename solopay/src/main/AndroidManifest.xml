<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application>
        <!-- 依赖库默认为 sensorLandscape，覆盖为竖屏扫码 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
        <activity
            android:name=".ui.SoloPayMainActivity"
            android:exported="true"
            android:label="@string/solopay_app_name"
            android:screenOrientation="portrait"
            android:theme="@style/SoloPayTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BindScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SoloPayTheme" />

        <activity
            android:name=".ui.LegacyForwarderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SoloPayTheme" />

        <service
            android:name="cn.solopay.service.SoloPayKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
