<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xui_config_color_background"
    android:orientation="vertical">

    <com.xuexiang.xui.widget.actionbar.TitleBar
        android:id="@+id/solopay_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView style="@style/SoloPayScrollViewStyle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/solopay_perm_intro"
                android:textColor="@color/xui_config_color_content_text"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/solopay_btn_notif_listener"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/solopay_perm_notif_listener"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/solopay_color_primary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/solopay_btn_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/solopay_perm_battery"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/solopay_color_primary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/solopay_btn_post_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/solopay_perm_post_notifications"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/solopay_color_primary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/solopay_btn_autostart_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/solopay_btn_outlined"
                android:text="@string/solopay_perm_autostart"
                android:textColor="@color/solopay_color_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
